{
    log {
        output file /var/log/caddy/access.log {
            roll_size 100mb
            roll_keep 5
            roll_keep_for 7d
        }
        format json
    }
    metrics
}


:80 {
    respond "This is port 80 (default HTTP)"
}


https://localhost:443 {
    tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem
    root * .
    file_server

    @users {
        path /api/users*
        not path /login
    }

    @posts {
        path /api/posts*
    }

    forward_auth @users {$USERS_CONTAINER}:8000 {
        uri /verify
        copy_headers Cookie
    }

    forward_auth @posts {$USERS_CONTAINER}:8000 {
        uri /verify
        copy_headers Authorization Cookie
    }

    header @users {
        Access-Control-Allow-Origin "https://localhost:443"
        Access-Control-Allow-Credentials "true"
        Access-Control-Allow-Headers "Authorization, Cookie"
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    }

    header @posts {
        Access-Control-Allow-Origin "https://localhost:443"
        Access-Control-Allow-Credentials "true"
        Access-Control-Allow-Headers "Authorization, Cookie"
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    }

    handle_path /api/users* {
        reverse_proxy {$USERS_CONTAINER}:8080 {
            health_uri /healthz
            health_interval 10s
            health_timeout 2s
            health_status 200
        }
    }

    handle_path /api/posts* {
        reverse_proxy {$POSTS_CONTAINER}:8080 {
            health_uri /healthz
            health_interval 10s
            health_timeout 2s
            health_status 200
        }
    }

    handle_path /api/followers* {
        reverse_proxy {$FOLLOWERS_CONTAINER}:8080 {
            health_uri /healthz
            health_interval 10s
            health_timeout 2s
            health_status 200
        }
    }

    handle_path /api/reactions* {
        reverse_proxy {$REACTIONS_CONTAINER}:8080 {
            health_uri /healthz
            health_interval 10s
            health_timeout 2s
            health_status 200
        }
    }

    handle_path /api/comments* {
        reverse_proxy {$COMMENTS_CONTAINER}:8080 {
            health_uri /healthz
            health_interval 10s
            health_timeout 2s
            health_status 200
        }
    }
}